DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=closet_db
PORT=3000
SESSION_SECRET=change_this_to_a_long_random_secret_string

# 관리자 초기 계정 생성용 (npm run create-admin 실행 시 사용)
ADMIN_USERID=admin
ADMIN_PASSWORD=change_this_strong_admin_password
ADMIN_NAME=CLOSET 관리자
ADMIN_EMAIL=admin@example.com

# 시연용 일반 회원 등록용 (node scripts/seedDemoData.js 실행 시 사용)
DEMO_MEMBER_USERID=demouser
DEMO_MEMBER_PASSWORD=change_this_demo_member_password
DEMO_MEMBER_NAME=김클로젯
DEMO_MEMBER_EMAIL=demo@example.com
