<%- include('../partials/header') %>

<main class="admin-main">
  <div class="container">
    <%- include('./_nav', {
      adminHeading: '상품 관리',
      adminSubtitle: '총 ' + products.length + '개의 상품이 조회되었습니다.'
    }) %>

    <div class="admin-toolbar">
      <div class="category-tabs">
        <a href="/admin/products" class="category-tab <%= !activeCategory ? 'is-active' : '' %>">ALL</a>
        <% categories.forEach(function(cat) { %>
          <a
            href="/admin/products?category=<%= encodeURIComponent(cat) %>"
            class="category-tab <%= activeCategory === cat ? 'is-active' : '' %>"
          ><%= cat %></a>
        <% }); %>
      </div>

      <div class="admin-toolbar-right">
        <form action="/admin/products" method="GET" class="admin-search-form" role="search">
          <% if (activeCategory) { %>
            <input type="hidden" name="category" value="<%= activeCategory %>" />
          <% } %>
          <input
            type="search"
            name="search"
            class="inline-search-input"
            placeholder="상품명 검색"
            value="<%= searchTerm || '' %>"
            maxlength="50"
            aria-label="상품명 검색"
          />
          <button type="submit" class="btn btn-outline admin-btn-sm">검색</button>
        </form>
        <a href="/admin/products/new" class="btn btn-primary admin-btn-sm">+ 새 상품 등록</a>
      </div>
    </div>

    <% if (products && products.length > 0) { %>
      <div class="admin-panel">
        <div class="admin-table-wrap">
          <table class="admin-table">
            <thead>
              <tr>
                <th>ID</th>
                <th>이미지</th>
                <th>상품명</th>
                <th>카테고리</th>
                <th>가격</th>
                <th>재고</th>
                <th>옵션 (사이즈 / 색상)</th>
                <th>등록일</th>
                <th>관리</th>
              </tr>
            </thead>
            <tbody>
              <% products.forEach(function(product) { %>
                <tr>
                  <td>#<%= product.id %></td>
                  <td>
                    <img
                      src="<%= product.image ? product.image : '/images/no-image.svg' %>"
                      alt="<%= product.name %>"
                      class="admin-product-thumb"
                    />
                  </td>
                  <td>
                    <a href="/products/<%= product.id %>" class="admin-table-link">
                      <strong><%= product.name %></strong>
                    </a>
                  </td>
                  <td><span class="admin-badge"><%= product.category %></span></td>
                  <td class="admin-cell-nowrap"><%= Number(product.price).toLocaleString('ko-KR') %>원</td>
                  <td>
                    <span class="admin-stock-pill <%= Number(product.stock) <= 0 ? 'is-soldout' : Number(product.stock) <= 5 ? 'is-low' : '' %>">
                      <%= Number(product.stock) <= 0 ? '품절 (0)' : product.stock + '개' %>
                    </span>
                  </td>
                  <td>
                    <span class="admin-cell-sub">
                      사이즈: <%= product.sizesList.length > 0 ? product.sizesList.join(', ') : '-' %>
                    </span>
                    <span class="admin-cell-sub">
                      색상: <%= product.colorsList.length > 0 ? product.colorsList.join(', ') : '-' %>
                    </span>
                  </td>
                  <td class="admin-cell-sub admin-cell-nowrap"><%= formatKoreanDateTime(product.created_at) %></td>
                  <td>
                    <div class="admin-row-actions">
                      <a href="/admin/products/<%= product.id %>/edit" class="btn btn-outline admin-btn-xs">수정</a>
                      <form
                        action="/admin/products/<%= product.id %>/delete"
                        method="POST"
                        data-confirm="정말 '<%= product.name %>' 상품을 삭제하시겠습니까?"
                      >
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                        <button type="submit" class="btn btn-danger admin-btn-xs">삭제</button>
                      </form>
                    </div>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      </div>
    <% } else { %>
      <div class="empty-state-box">
        <p class="empty-state-title">조건에 해당하는 상품이 없습니다.</p>
        <p class="empty-state-desc">새 상품을 등록하거나 필터 조건을 초기화해 보세요.</p>
        <div class="empty-state-action">
          <a href="/admin/products" class="btn btn-outline">전체 목록</a>
          <a href="/admin/products/new" class="btn btn-primary">+ 새 상품 등록</a>
        </div>
      </div>
    <% } %>
  </div>
</main>

<%- include('../partials/footer') %>
