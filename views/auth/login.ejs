<%- include('../partials/header') %>

<main class="auth-main">
  <div class="container">
    <section class="auth-card">
      <div class="auth-header">
        <span class="section-eyebrow">MEMBER SIGN IN</span>
        <h1 class="auth-title">로그인</h1>
        <p class="auth-subtitle">CLOSET 회원 계정으로 로그인해 주세요.</p>
      </div>

      <% if (typeof flash !== 'undefined' && flash && flash.message) { %>
        <div class="alert <%= flash.type === 'error' ? 'alert-error' : 'alert-success' %>" role="alert">
          <%= flash.message %>
        </div>
      <% } %>

      <% if (error) { %>
        <div class="alert alert-error" role="alert">
          <%= error %>
        </div>
      <% } %>

      <form action="/auth/login" method="POST" class="auth-form">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

        <div class="form-group">
          <label for="userid" class="form-label">아이디</label>
          <input
            type="text"
            id="userid"
            name="userid"
            class="form-input"
            placeholder="아이디를 입력하세요"
            value="<%= userid || '' %>"
            required
            autocomplete="username"
          />
        </div>

        <div class="form-group">
          <label for="password" class="form-label">비밀번호</label>
          <input
            type="password"
            id="password"
            name="password"
            class="form-input"
            placeholder="비밀번호를 입력하세요"
            required
            autocomplete="current-password"
          />
        </div>

        <button type="submit" class="btn btn-primary btn-full auth-submit-btn">로그인</button>
      </form>

      <div class="auth-footer-links">
        <span>아직 CLOSET 회원이 아니신가요?</span>
        <a href="/auth/register" class="auth-text-link">회원가입</a>
      </div>
    </section>
  </div>
</main>

<%- include('../partials/footer') %>
